# ==============================================
# Marutabi .env.example
# ==============================================
# 注意:
# - ブラウザに公開したい値は NEXT_PUBLIC_ で始めます
# - AWS 予約接頭辞 `AWS_` は使用しないでください（Amplify制約）
# - 値は必要に応じて Amplify 環境変数にも設定してください

# ===== App / NextAuth =====
# 本番のフルURL（例: https://your-app.amplifyapp.com）
NEXTAUTH_URL=
# ランダムな長い秘密文字列（OpenSSL等で生成）
NEXTAUTH_SECRET=

# ===== Auth Providers (必要なものだけ設定) =====
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cognito (使う場合のみ)
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER= # 例: https://your-domain.auth.ap-northeast-1.amazoncognito.com

# ===== Supabase =====
# フロントエンドで使う公開キー（必須: クライアント側）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー側のみで使う値（任意・ある場合は優先）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== Database (Prisma) =====
DATABASE_URL=

# ===== LLM / AI =====
# 使用するプロバイダ: "openai" or "bedrock"
LLM_PROVIDER=openai

# OpenAI を使う場合
OPENAI_API_KEY=

# Bedrock を使う場合（AWS_ 接頭辞は禁止）
BEDROCK_REGION= # 例: ap-northeast-1
BEDROCK_MODEL_ID= # 例: anthropic.claude-3-5-sonnet-20240620-v1:0

# ===== Notifications (DynamoDB; 任意) =====
NOTIFICATIONS_REGION= # 例: ap-northeast-1
NOTIFICATIONS_TABLE=

# ===== Ekispert API (任意: ルート検索) =====
EKS_API_KEY=

# ===== Cache (Upstash; 任意) =====
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Linked Open Data / SPARQL (任意) =====
# フロントで参照するエンドポイント
NEXT_PUBLIC_SPARQL_ENDPOINT=
# サーバー側のみで上書きしたい場合
SPARQL_ENDPOINT=
